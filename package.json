{
	"name": "anikehai-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "bunx biome check",
		"lint:fix": "bunx biome check --write",
		"format": "bunx biome format --write",
		"validate": "bun run lint && bun run typecheck",
		"seo:check": "node scripts/seo-check.mjs",
		"indexnow": "node scripts/indexnow.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"lucide-react": "^1.57.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7.0.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "~7.0.2",
		"vite": "^8.3.4"
	}
}
